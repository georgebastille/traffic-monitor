[Unit]
Description=Traffic Monitor API
After=network.target

[Service]
User=richie
WorkingDirectory=/home/richie/traffic
EnvironmentFile=/home/richie/traffic/.env
ExecStart=/home/richie/.local/bin/uv run uvicorn traffic_monitor.api:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
